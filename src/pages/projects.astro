---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projectsInOrder } from '../lib/content';
const projects = await projectsInOrder();
---
<Layout title="Projects" description="Projects by Paul Bennett-Freeman, including is.today.blackfriday?" section="projects"><header class="intro"><p class="eyebrow">01 / Things made</p><h1>Projects</h1><p class="lede">Things that I have built</p></header><h2 class="sr-only">All projects</h2><div class="grid">{projects.map(project => <ProjectCard project={project}/>)}</div></Layout>
