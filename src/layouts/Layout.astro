---
import Shell from '../components/Shell';
import 'blackchalk/styles.css';
import '../fonts.css';
import caveatLatin from '../assets/fonts/caveat-latin.woff2?url';
import '../styles.css';
interface Props { title: string; description: string; section?: string }
const { title, description, section } = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="light">
  <head><link rel="preload" href={caveatLatin} as="font" type="font/woff2" crossorigin="anonymous"/><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title} | OddEssay.com</title><meta name="description" content={description}/></head>
  <body class="sketch-paper"><a class="skip-link" href="#content">Skip to content</a><Shell section={section}><slot/></Shell></body>
</html>
