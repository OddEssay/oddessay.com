---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
interface Props { restaurant: CollectionEntry<'restaurants'>['data'] }
const { restaurant: r } = Astro.props;
---
<restaurant-image>
  <figure>
    <div class="restaurant-image-frame">
      <Image data-illustration src={r.image} alt={r.imageAlt} width={640} height={420} format="webp" loading="lazy"/>
      {r.originalImage && <Image data-photo src={r.originalImage} alt={r.originalImageAlt!} aria-hidden="true" width={640} height={420} format="webp" loading="lazy"/>}
    </div>
    <figcaption>
      {r.example && 'Example · '}<span data-caption>Generated illustration</span>
      {r.originalImage && <button type="button" data-toggle hidden aria-pressed="false" aria-label={`Show photo of ${r.title}`}></button>}
    </figcaption>
  </figure>
</restaurant-image>
<script>
  import { initializeRestaurantImage } from '../lib/restaurant-image';
  class RestaurantImage extends HTMLElement {
    connectedCallback() {
      if (this.dataset.initialized) return;
      this.dataset.initialized = 'true';
      initializeRestaurantImage(this);
    }
  }
  if (!customElements.get('restaurant-image')) customElements.define('restaurant-image', RestaurantImage);
</script>
