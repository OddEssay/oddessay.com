---
import RestaurantImage from './RestaurantImage.astro';
import { SketchCard, SketchBadge } from 'blackchalk';
import type { CollectionEntry } from 'astro:content';
import { filterPath, tagLabel, type Filter } from '../lib/restaurants';
interface Props { restaurant: CollectionEntry<'restaurants'>; filter?: Filter }
const { restaurant: { data: r, id }, filter = {} } = Astro.props;
---
<article>
  <SketchCard client:load block padding={0} className="restaurant-card">
    <RestaurantImage restaurant={r}/>
    <div class="card-content"><h3><a href={`/restaurants/place/${id}`}>{r.title}</a></h3>
      <p>{r.summary}</p>
      <a class="location" href={filterPath({ city: r.citySlug, tag: filter.tag })}>{r.city}</a>
      <ul class="tags">{r.tags.map(tag => <li><a href={filterPath({ city: filter.city, tag })}><SketchBadge client:load>{tagLabel(tag)}</SketchBadge></a></li>)}</ul>
    </div>
  </SketchCard>
</article>
