---
import RestaurantImage from './RestaurantImage.astro';
import SketchCard from './SketchCard';
import SketchBadge from './SketchBadge';
import type { CollectionEntry } from 'astro:content';
import { citySlug, filterPath, tagLabel, type Filter } from '../lib/restaurants';
interface Props { restaurant: CollectionEntry<'restaurants'>; filter?: Filter }
const { restaurant: { data: r, id }, filter = {} } = Astro.props;
---
<article>
  <SketchCard client:load block padding={8} className="restaurant-card">
    <RestaurantImage restaurant={r} href={`/restaurants/place/${id}`}/>
    <div class="card-content"><h3><a href={`/restaurants/place/${id}`}>{r.title}</a></h3>
      <a class="restaurant-url" href={r.url}>{r.url}</a>
      <p>{r.summary}</p>
      <a class="location" href={filterPath({ city: citySlug(r.city), tag: filter.tag })}>{r.city}</a>
      <ul class="tags">{r.tags.map(tag => <li><a href={filterPath({ city: filter.city, tag })}><SketchBadge client:load>{tagLabel(tag)}</SketchBadge></a></li>)}</ul>
    </div>
  </SketchCard>
</article>
